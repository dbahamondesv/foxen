{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foxen",
  "version": "0.1.0",
  "identifier": "com.foxbuntu.foxen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Foxen",
        "width": 1500,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["default"],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Gestor de ramas git",
    "longDescription": "Foxen es un cliente de escritorio para gestionar repositorios git: grafo de commits, ramas, staging, stashes y remotos.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "desktopTemplate": "../packaging/deb/foxen.desktop",
        "files": {
          "/usr/share/metainfo/com.foxbuntu.foxen.metainfo.xml": "../packaging/deb/com.foxbuntu.foxen.metainfo.xml"
        }
      }
    }
  },
  "plugins": {}
}