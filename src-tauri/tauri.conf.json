{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foxen",
  "version": "0.1.0",
  "identifier": "com.foxbuntu.foxen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Foxen",
        "width": 1500,
        "height": 940,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": [
        "default"
      ],
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Gestor de ramas git",
    "longDescription": "Foxen es un cliente de escritorio para gestionar repositorios git: grafo de commits, ramas, staging, stashes y remotos.",
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/foxen.desktop",
        "files": {
          "/usr/share/metainfo/io.github.dbahamondesv.foxen.metainfo.xml": "../packaging/io.github.dbahamondesv.foxen.metainfo.xml",
          "/usr/share/icons/hicolor/32x32/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/icon.png"
        }
      },
      "rpm": {
        "desktopTemplate": "../packaging/foxen.hidden.desktop",
        "files": {
          "/usr/share/metainfo/io.github.dbahamondesv.foxen.metainfo.xml": "../packaging/io.github.dbahamondesv.foxen.metainfo.xml",
          "/usr/share/applications/com.foxbuntu.foxen.desktop": "../packaging/foxen.desktop",
          "/usr/share/icons/hicolor/32x32/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/icon.png"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/io.github.dbahamondesv.foxen.metainfo.xml": "../packaging/io.github.dbahamondesv.foxen.metainfo.xml",
          "/com.foxbuntu.foxen.png": "../src-tauri/icons/icon.png",
          "/usr/share/icons/hicolor/32x32/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/32x32.png",
          "/usr/share/icons/hicolor/128x128/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/com.foxbuntu.foxen.png": "../src-tauri/icons/icon.png"
        }
      }
    }
  },
  "plugins": {}
}
